# Copy to .env and replace every "changethis" with real values.
# Consumer service — validates tokens issued by auth_user_service.
# Does NOT include auth-service-only settings (FIRST_SUPERUSER,
# TOKENS_ENCRYPTION_KEY, key files).

# ── Identity ──────────────────────────────────────────────────────────────────
DOMAIN=localhost
ENVIRONMENT=local
PROJECT_NAME=PromptEngineM8
STACK_NAME=prompt-engine-m8

# ── API & docs ────────────────────────────────────────────────────────────────
API_PREFIX=/fastapi
SET_OPEN_API=true
SET_DOCS=true
SET_REDOC=true

# ── CORS / Frontend ───────────────────────────────────────────────────────────
BACKEND_HOST=http://127.0.0.1:9000
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:9000,https://localhost,https://localhost:9000,https://localhost:5173

# ── Service role & auth routing ───────────────────────────────────────────────
# consumer = validates tokens only; never holds a private signing key
AUTH_SERVICE_ROLE=consumer
# Must match the API_PREFIX of auth_user_service (default: /user)
AUTH_PREFIX=/user

# ── Database ──────────────────────────────────────────────────────────────────
SELECTED_DB=Mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api_db
DB_USER=changethis
DB_PASSWORD=changethis

# ── Token verification ────────────────────────────────────────────────────────
# HS256 mode: share the same ACCESS_SECRET_KEY with auth_user_service
ACCESS_SECRET_KEY=changethis
REFRESH_SECRET_KEY=changethis
ACCESS_TOKEN_ALGORITHM=HS256
REFRESH_TOKEN_ALGORITHM=HS256

# Must match auth_user_service TOKEN_MODE exactly:
#   stateless — no revocation
#   hybrid    — revocation for refresh tokens only (no introspection needed)
#   stateful  — full revocation via HTTP introspection (requires INTROSPECTION_URL)
TOKEN_MODE=stateful

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=3600

# RS256 / ES256 asymmetric mode (comment out the HS256 block above):
# ACCESS_TOKEN_ALGORITHM=RS256
# JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
# JWKS_CACHE_TTL_SECONDS=300
# REFRESH_SECRET_KEY=changethis
# REFRESH_TOKEN_ALGORITHM=HS256

# ── Token boundary claims (recommended for production) ────────────────────────
# Must match auth_user_service TOKEN_ISSUER / TOKEN_AUDIENCE exactly.
# When set, tokens with a different iss or aud claim are rejected.
# In production with STRICT_PRODUCTION_MODE=true these become required (startup fatal).
#TOKEN_ISSUER=https://auth.example.com
#TOKEN_AUDIENCE=https://api.example.com

# ── Token revocation (stateful mode only) ─────────────────────────────────────
# Required when TOKEN_MODE=stateful. Must match auth_user_service PRIVATE_API_SECRET.
# The auth service exposes this endpoint on its Docker-internal network only.
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
PRIVATE_API_SECRET=changethis

# ── API-key remote introspection (§3.12) ──────────────────────────────────────
# Enables the remote API-key principal dependencies (get_current_api_key_principal /
# require_api_key_role) so a key resolves its owner's *live* role via the issuer's
# POST /private/v1/api-keys/introspect — never a bare/cached key check. Fails
# closed at startup if incomplete. Independent of INTROSPECTION_URL above (that
# pair is JTI-revocation only). Requires this consumer to hold the
# api-key-introspection scope in auth_user_service PRIVATE_API_CONSUMERS.
# prompt-engine-m8 does not support API keys today — no route depends on
# get_current_api_key_reader/_writer, so this block stays commented out.
# tests/test_role_tiers.py asserts the wiring stays that way (audit_api_key_routes).
# API_KEY_INTROSPECTION_ENABLED=true
# API_KEY_INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/api-keys/introspect

# ── Revocation failure mode (consumer) ───────────────────────────────────────
# Behaviour when the fa-auth introspection call fails.
# fail_closed (default, secure): reject the request. fail_open: allow through
# (availability over strictness; each swallowed failure is logged + counted).
# Declared explicitly here rather than left to inherit the SDK default.
ACCESS_REVOCATION_FAILURE_MODE=fail_closed

# ── Observability ─────────────────────────────────────────────────────────────
# Master switch — false = zero overhead, /metrics endpoint not registered
#METRICS_ENABLED=false
# Comma-separated groups or "all": traffic | performance | reliability | health
#METRICS_GROUPS=all
# Optional static scoped scrape credential for {API_PREFIX}/metrics. Leave unset
# to keep metrics internal-only (the network boundary is the control). When set,
# scrapers must send `Authorization: Bearer <credential>` (constant-time match).
#METRICS_SCRAPE_CREDENTIAL=changethis

# ── Response security headers (auth-sdk-m8 >= 1.2.1, three tiers) ────────────────
# Applied by fastapi-m8 create_app. Tier 1 (X-Content-Type-Options, X-Frame-Options)
# is always on; tier 2 (Referrer-Policy, Permissions-Policy) applies on the production
# gate. Tier 3 below is browser-persisted and hard to reverse (HSTS poisons a host's
# HTTPS cache for its full max-age), so it is express opt-in, defaults to off, and is
# NEVER emitted on a local stack even if enabled. Enable only on a TLS-terminated host.
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
