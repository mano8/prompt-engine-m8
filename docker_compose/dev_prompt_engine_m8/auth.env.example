# Copy to auth.env. Replace every changethis value before starting the stack.

# Hostname this stack is served on (localhost, an IPv4 or a domain).
DOMAIN=localhost
# local | development | staging | production - selects the SDK's security
# posture.
ENVIRONMENT=local
# Project identifier shown in API docs and logs (letters, digits, _ and -).
PROJECT_NAME=MyAuthService
# Stack slug used in names and logs (lowercase letters, digits and -).
STACK_NAME=my-auth-service

# Route prefix the service is mounted under behind Traefik (path chars only,
# e.g. /user).
API_PREFIX=/user
# Serve the OpenAPI schema (true | false).
SET_OPEN_API=true
# Serve Swagger UI (true | false).
SET_DOCS=true
# Serve ReDoc (true | false).
SET_REDOC=true
# Public base URL of this backend (scheme://host[:port]).
BACKEND_HOST=http://127.0.0.1:9000
# Public URL of the frontend (scheme://host[:port]); used in links the backend
# emits.
FRONTEND_HOST=http://localhost:5173
# Comma-separated browser origins allowed by CORS, each scheme://host[:port]
# with no path.
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:9000,https://localhost:4430
# issuer (mints tokens, holds keys) or consumer (only validates tokens; must
# not hold private keys).
AUTH_SERVICE_ROLE=issuer

# Database dialect: Postgres | Mysql | Mariadb.
SELECTED_DB=Postgres
# Database hostname (compose service name, or a managed DB host).
DB_HOST=m8_db
# Database port (1-65535; 5432 for PostgreSQL).
DB_PORT=5432
# Database name the service connects to (letters, digits, _ and -).
DB_DATABASE=auth_db
# Database role the service logs in as (created by init-db.sh).
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
DB_USER=changethis
# Password of DB_USER.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
DB_PASSWORD=changethis

# Redis hostname (compose service name).
REDIS_HOST=redis_cache
# Redis port (1-65535, default 6379).
REDIS_PORT=6379
# Redis ACL user name.
REDIS_USER=auth
# Password of REDIS_USER; identical in the Redis ACL and every client.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
REDIS_PASSWORD=changethis

# Access-token algorithm: RS256 (default, asymmetric via JWKS) or HS256
# (shared ACCESS_SECRET_KEY).
ACCESS_TOKEN_ALGORITHM=RS256
# Must be HS256 (SDK-enforced).
REFRESH_TOKEN_ALGORITHM=HS256
# Container path of the RS256/ES256 private key (issuer only), mounted read-
# only from ./keys.
ACCESS_PRIVATE_KEY_FILE=/opt/keys/private.pem
# Container path of the matching public key, mounted read-only from ./keys.
ACCESS_PUBLIC_KEY_FILE=/opt/keys/public.pem
# JWKS kid of the signing key; must equal the public key's DER SHA-256
# fingerprint (startup fails on mismatch). init.sh binds it to the mounted
# key.
ACCESS_KEY_ID=changethis_hex_kid
# HS256 refresh-token key (refresh tokens are always HS256); required even on
# consumers.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
REFRESH_SECRET_KEY=changethis
# stateless (pure JWT) | hybrid (refresh JTIs in Redis) | stateful (Redis
# blacklist + DB sessions); must match the issuer.
TOKEN_MODE=stateful
# Access-token lifetime in minutes (SDK default 30); keep it short and equal
# across issuer and consumers.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in minutes (SDK default 120).
REFRESH_TOKEN_EXPIRE_MINUTES=1440
# iss claim tokens carry and validators require; identical in the issuer and
# every consumer.
TOKEN_ISSUER=https://auth.example.com
# aud claim tokens carry and validators require; identical in the issuer and
# every consumer.
TOKEN_AUDIENCE=https://prompt-engine.example.com

# E-mail of the bootstrap superuser created on first start.
FIRST_SUPERUSER=admin@example.com
# Password of FIRST_SUPERUSER.
# Value: 8-72 chars (bcrypt caps passwords at 72 bytes); mix upper, lower,
#   digit and a symbol (- _ . ~); no spaces, $, #, quotes or backslash.
FIRST_SUPERUSER_PASSWORD=changethis
# Bootstrap secret for private-API calls; the consumer's value must match its
# entry in the issuer's PRIVATE_API_CONSUMERS.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
PRIVATE_API_SECRET=changethis
# JSON map client-id -> {secret: sha256$<salt>$<digest>, scopes: [...]} of
# consumers allowed on /private.
PRIVATE_API_CONSUMERS={"prompt-engine-service":{"secret":"changethis","scopes":["introspection","event-stream"]}}
# Signs the OAuth/session state cookie; unique, never reused elsewhere.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
SESSION_SECRET=changethis
# Encrypts the tokens the issuer stores at rest (Fernet key derived from it);
# rotate via TOKENS_ENCRYPTION_KEY_OLD.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
TOKENS_ENCRYPTION_KEY=changethis

# Sign/verify auth events with EVENT_SIGNING_KEY (default true; boot fails
# without the key).
EVENT_SIGNING_ENABLED=true
# HMAC key for auth event signing; identical in the issuer and every consumer.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
EVENT_SIGNING_KEY=changethis
# Serve the private SSE auth-event stream consumers use to evict caches early
# (default true).
EVENT_STREAM_ENABLED=true
# Events kept for Last-Event-ID resume (1-100000, default 256).
EVENT_STREAM_BUFFER_SIZE=256
# SSE heartbeat interval in seconds (>0 to 300, default 15); keep below the
# consumer read timeout.
EVENT_STREAM_HEARTBEAT_SECONDS=15
# Per-connection queue depth before a slow consumer is dropped (1-100000,
# default 64).
EVENT_STREAM_MAX_QUEUE=64

# true forces every Redis-dependent security control to fail_closed (503) when
# Redis is down.
AUTH_STRICT_MODE=true
# Rate limiter when Redis fails: fail_open (default) or fail_closed (503).
RATE_LIMIT_FAILURE_MODE=fail_closed
# When the revocation check cannot reach Redis/the issuer: fail_closed
# (reject, default) or fail_open (allow, logged).
ACCESS_REVOCATION_FAILURE_MODE=fail_closed

# Expose Prometheus /metrics (default false).
METRICS_ENABLED=true
# Comma list of metric groups: all | traffic, performance, reliability,
# health, auth.
METRICS_GROUPS=all
