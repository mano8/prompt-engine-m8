# Grafana admin login name.
GF_SECURITY_ADMIN_USER=admin
# Grafana admin password.
# Value: not validated by the services; use 16+ chars (32 recommended), no
#   max; letters, digits and - _ . ~ only.
GF_SECURITY_ADMIN_PASSWORD=changethis
# Grafana: allow self-service sign-up (keep false).
GF_USERS_ALLOW_SIGN_UP=false
# Grafana: send anonymous usage stats (keep false).
GF_ANALYTICS_REPORTING_ENABLED=false
# Grafana: check grafana.com for updates (keep false: no phoning home).
GF_ANALYTICS_CHECK_FOR_UPDATES=false
# Grafana log level: debug | info | warn | error.
GF_LOG_LEVEL=warn
