# Copy to .env. Application settings go in auth.env and prompt.env.
# Generate passwords: python -c "import secrets,string; a=string.ascii_letters+string.digits; print('Aa1-'+''.join(secrets.choice(a) for _ in range(44)))"

# Default 127.0.0.1. Set to 0.0.0.0 to expose the API entrypoint on the LAN.
#API_BIND_IP=127.0.0.1

# PostgreSQL superuser the engine container and init-db.sh use; services get
# their own roles.
DB_USER=m8_admin
# Password of the PostgreSQL superuser (engine bootstrap only).
# Value: not validated by the services; use 16+ chars (32 recommended), no
#   max; letters, digits and - _ . ~ only.
DB_PASSWORD=changethis
# Database port (1-65535; 5432 for PostgreSQL).
DB_PORT=5432

# Role init-db.sh creates for auth_user_service; must equal DB_USER in
# auth.env.
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
AUTH_DB_USER=changethis
# Password of AUTH_DB_USER; must equal DB_PASSWORD in auth.env.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
AUTH_DB_PASSWORD=changethis
# Database init-db.sh creates for auth_user_service; must equal DB_DATABASE in
# auth.env.
AUTH_DB_NAME=auth_db

# Role init-db.sh creates for prompt_engine_service; must equal DB_USER in
# prompt.env.
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
PROMPT_ENGINE_DB_USER=changethis
# Password of PROMPT_ENGINE_DB_USER; must equal DB_PASSWORD in prompt.env.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
PROMPT_ENGINE_DB_PASSWORD=changethis
# Database init-db.sh creates for prompt_engine_service; must equal
# DB_DATABASE in prompt.env.
PROMPT_ENGINE_DB_NAME=prompt_engine_db

# Redis ACL password; must equal REDIS_PASSWORD in every service env file of
# this stack.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
REDIS_PASSWORD=changethis
